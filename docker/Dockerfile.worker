# --- Build stage ---
FROM golang:1.25-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/worker ./cmd/worker

# --- Runtime stage ---
FROM alpine:3.19
RUN apk --no-cache add ca-certificates && adduser -D -u 1000 appuser
COPY --from=builder /app/bin/worker /app/bin/worker
USER appuser
CMD ["/app/bin/worker"]
